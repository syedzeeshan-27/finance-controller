# Optional. Everything runs fully offline and deterministic without this file.
# An API key enables LIVE agent runs only - `agent.eval_resolve --record`
# (the resolver on the dev/held-out worlds), `agent.intake --batch` and
# `agent.intake --record` (map bank exports), `agent.investigate --record`
# (draft a note on a queue item) - which record replayable transcripts.
# The dashboard never calls the API: explanations are deterministic templates
# (LLM rephrasing exists only behind attach_explanations(use_llm=True), which
# nothing in the app passes). Engine decisions are unaffected either way
# (pinned by tests/test_explain.py and the agent quarantine tests); committed
# agent transcripts replay without any key.
#
# Google Gemini (picked when set; the free tier works):
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Hard stop for live runs, in list-price US dollars:
AGENT_MAX_USD=10
# Anthropic (used when GEMINI_API_KEY is empty):
ANTHROPIC_API_KEY=
APP_LLM_MODEL=claude-sonnet-5
# Force offline mode even if a key is present:
APP_USE_MOCK=0
