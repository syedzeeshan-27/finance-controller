# Optional. Everything runs fully offline and deterministic without this file.
# An API key enables LIVE agent runs only - `agent.intake --record` (map a new
# bank export) and `agent.investigate --record` (draft a note on a queue item)
# - which record replayable transcripts. The dashboard never calls the API:
# explanations are deterministic templates (LLM rephrasing exists only behind
# attach_explanations(use_llm=True), which nothing in the app passes).
# Reconciliation decisions are unaffected either way (pinned by
# tests/test_explain.py and the agent quarantine tests); committed agent
# transcripts replay without any key.
ANTHROPIC_API_KEY=
APP_LLM_MODEL=claude-sonnet-5
# Force offline mode even if a key is present:
APP_USE_MOCK=0
