# Source, docs and generated worlds are compared byte for byte by the tests:
# check them out with LF everywhere, whatever core.autocrlf says.
# (Listed first: later, more specific lines below override it.)
* text=auto eol=lf

# Webhook fixture bytes are signed (HMAC over the exact file content):
# never let EOL conversion rewrite them on checkout.
data/fixtures/razorpay/webhooks/** -text
data/real/statement_a/statement.xlsx binary
# Synthetic bank exports are generated byte for byte (CSV with CRLF + BOM, like a
# real export): keep git's EOL conversion off them.
data/lookalikes/*.csv -text
data/lookalikes/*.xlsx binary
